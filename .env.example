# Връзката към Neon (Vercel я добавя автоматично с Neon интеграцията)
DATABASE_URL=postgres://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Парола за админ панела (задължителна)
ADMIN_PASSWORD=смени-ме-с-дълга-парола

# По желание: таен ключ за подписване на сесиите (админ и потребители).
# Ако липсва, се ползва ADMIN_PASSWORD.
SESSION_SECRET=
